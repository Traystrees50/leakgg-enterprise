# Leaked.GG Discord Webhooks per Platform
# Set your platform-specific Discord webhook URLs below. If a platform webhook is empty, DISCORD_WEBHOOK_URL is used as fallback.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_STAKE_COM=
DISCORD_WEBHOOK_STAKE_US=
DISCORD_WEBHOOK_SHUFFLE_COM=
DISCORD_WEBHOOK_SHUFFLE_US=
DISCORD_WEBHOOK_QZINO=
DISCORD_WEBHOOK_RAINBET=
DISCORD_WEBHOOK_DEGEN=
DISCORD_WEBHOOK_GOATED=

# Discord Bot Token (for on-demand !code and /activecodes commands)
DISCORD_BOT_TOKEN=

# Dedicated Platform Affiliate Signup Links
AFFILIATE_STAKE_COM=https://stake.com/?c=SELFMADE
AFFILIATE_STAKE_US=https://www.stake.us/?c=selfmade
AFFILIATE_SHUFFLE_COM=https://shuffle.com/?r=selfmade
AFFILIATE_SHUFFLE_US=https://shuffle.us/?r=selfmade
AFFILIATE_QZINO=https://qzino.ai/?r=SELFMADE
AFFILIATE_RAINBET=https://rainbet.com/?r=smokerzsektion
AFFILIATE_DEGEN=https://degen.com/r/selfmade
AFFILIATE_GOATED=https://goated.com/?r=selfmade

# Polling Interval (in seconds)
CHECK_INTERVAL_SECONDS=120
REQUEST_TIMEOUT=15
STATE_FILE_PATH=seen_codes.json

# Optional OCR.space API key for extracting bonus codes embedded in Telegram images
# Get a free key at https://ocr.space/ocr-api
OCR_SPACE_API_KEY=

# Optional Telegram API credentials for private groups (e.g. t.me/c/1542279201/257)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=

# Discord Owner User ID (full admin access in the bot dashboard)
OWNER_USER_ID=0

